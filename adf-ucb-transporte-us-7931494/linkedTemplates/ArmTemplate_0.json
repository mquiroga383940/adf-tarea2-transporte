{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-ucb-transporte-us-7931494"
		},
		"sa_transporte_accountKey": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accountKey\"de \"sa_transporte\""
		},
		"sql_dw_transporte_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"sql_dw_transporte\""
		},
		"sql_erp_transporte_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"sql_erp_transporte\""
		},
		"sa_transporte_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://ucbtransporte7931494.dfs.core.windows.net/"
		},
		"sql_dw_transporte_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-server-transporte-7931494.database.windows.net"
		},
		"sql_dw_transporte_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dw_transporte"
		},
		"sql_dw_transporte_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "marcelo"
		},
		"sql_erp_transporte_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-server-transporte-7931494.database.windows.net"
		},
		"sql_erp_transporte_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "erp_transporte_db"
		},
		"sql_erp_transporte_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "marcelo"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/sa_transporte')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('sa_transporte_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('sa_transporte_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/sql_dw_transporte')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('sql_dw_transporte_properties_typeProperties_server')]",
					"database": "[parameters('sql_dw_transporte_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('sql_dw_transporte_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('sql_dw_transporte_password')]"
					}
				}
			},
			"dependsOn": []
