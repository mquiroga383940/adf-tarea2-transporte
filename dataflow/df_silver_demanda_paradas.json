{
	"name": "df_silver_demanda_paradas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derive1"
				},
				{
					"name": "derive2"
				},
				{
					"name": "derive3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(each(match(type=='string'), $$ = iif(isNull($$) || trim($$)=='' || in(['NULL','NAN','N/A','NA','S/D','#N/A'], upper(trim($$))), toString(null()), regexReplace(trim($$),'[ ]+',' ')))) ~> derive1",
				"derive1 derive(DemandaId = upper(DemandaId),",
				"          FechaServicio = iif(regexMatch(replace(regexReplace(FechaServicio,'[ T].*$',''),'-','/'),'^[0-9]{4}/.*'), toDate(replace(regexReplace(FechaServicio,'[ T].*$',''),'-','/'),'yyyy/M/d'), iif(regexMatch(replace(regexReplace(FechaServicio,'[ T].*$',''),'-','/'),'^[0-9]{5}$'), addDays(toDate('1899-12-30','yyyy-MM-dd'), toInteger(replace(regexReplace(FechaServicio,'[ T].*$',''),'-','/'))), toDate(replace(regexReplace(FechaServicio,'[ T].*$',''),'-','/'),'d/M/yyyy'))),",
				"          RutaHistoricaId = upper(RutaHistoricaId),",
				"          ParadaHistoricaId = upper(ParadaHistoricaId),",
				"          ValStr = regexReplace(replace(ValidacionesTarjeta,',','.'),'[^0-9.-]',''),",
				"          DesStr = regexReplace(replace(Descensos,',','.'),'[^0-9.-]',''),",
				"          DemNoAtStr = regexReplace(replace(DemandaNoAtendida,',','.'),'[^0-9.-]',''),",
				"          Metodo = upper(Metodo)) ~> derive2",
				"derive2 derive(AnioFuente = toShort(AnioFuente),",
				"          DemandaId = coalesce(DemandaId, concat(toString(FechaServicio,'yyyyMMdd'),'-',RutaHistoricaId,'-',ParadaHistoricaId,'-',coalesce(Franja,'NA'))),",
				"          ValidacionesTarjeta = iif(!isNull(ValStr) && toDouble(ValStr) >= 0, toInteger(round(toDouble(ValStr))), toInteger(null())),",
				"          Descensos = iif(!isNull(DesStr) && toDouble(DesStr) >= 0, toInteger(round(toDouble(DesStr))), toInteger(null())),",
				"          DemandaNoAtendida = iif(!isNull(DemNoAtStr) && toDouble(DemNoAtStr) >= 0, toInteger(round(toDouble(DemNoAtStr))), toInteger(null()))) ~> derive3",
				"derive3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          DemandaId,",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          ValidacionesTarjeta,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     )) ~> sink1"
			]
		}
	}
}