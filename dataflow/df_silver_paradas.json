{
	"name": "df_silver_paradas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derive1"
				},
				{
					"name": "derive2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          NombreParada as string,",
				"          Ubicacion as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          TipoParada as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(each(match(type=='string'), $$ = iif(isNull($$) || trim($$)=='' || in(['NULL','NAN','N/A','NA','S/D','#N/A'], upper(trim($$))), toString(null()), regexReplace(trim($$),'[ ]+',' ')))) ~> derive1",
				"derive1 derive(AnioFuente = toShort(AnioFuente),",
				"          ParadaHistoricaId = upper(ParadaHistoricaId),",
				"          NombreParada = left(initCap(lower(NombreParada)),100),",
				"          Latitud = toDecimal(round(toDouble(regexReplace(replace(Latitud,',','.'),'[^0-9.-]','')),6),9,6),",
				"          Longitud = toDecimal(round(toDouble(regexReplace(replace(Longitud,',','.'),'[^0-9.-]','')),6),9,6),",
				"          TipoParada = upper(TipoParada)) ~> derive2",
				"derive2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          ParadaHistoricaId,",
				"          NombreParada,",
				"          Latitud,",
				"          Longitud,",
				"          TipoParada",
				"     )) ~> sink1"
			]
		}
	}
}