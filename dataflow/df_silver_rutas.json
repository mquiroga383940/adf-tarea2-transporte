{
	"name": "df_silver_rutas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derive1"
				},
				{
					"name": "derive2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          DistanciaKm as string,",
				"          TipoServicio as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(each(match(type=='string'), $$ = iif(isNull($$) || trim($$)=='' || in(['NULL','NAN','N/A','NA','S/D','#N/A'], upper(trim($$))), toString(null()), regexReplace(trim($$),'[ ]+',' ')))) ~> derive1",
				"derive1 derive(AnioFuente = toShort(AnioFuente),",
				"          RutaHistoricaId = upper(RutaHistoricaId),",
				"          NombreRuta = left(initCap(lower(NombreRuta)),100),",
				"          Origen = left(initCap(lower(Origen)),100),",
				"          Destino = left(initCap(lower(Destino)),100),",
				"          DistanciaKm = toDecimal(round(toDouble(regexReplace(replace(DistanciaKm,',','.'),'[^0-9.-]','')),2),8,2),",
				"          TipoServicio = upper(TipoServicio)) ~> derive2",
				"derive2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          RutaHistoricaId,",
				"          NombreRuta,",
				"          Origen,",
				"          Destino,",
				"          DistanciaKm,",
				"          TipoServicio",
				"     )) ~> sink1"
			]
		}
	}
}