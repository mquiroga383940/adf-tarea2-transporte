{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "prutas"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "pvehiculos"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "srutas"
				},
				{
					"name": "svehiculos"
				},
				{
					"name": "derive1"
				},
				{
					"name": "derive2"
				},
				{
					"name": "derive3"
				},
				{
					"name": "filter1"
				},
				{
					"name": "window1"
				},
				{
					"name": "filter2"
				},
				{
					"name": "exists1"
				},
				{
					"name": "exists2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          AnioFuente as short,",
				"          RutaHistoricaId as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> prutas",
				"source(output(",
				"          AnioFuente as short,",
				"          VehiculoId as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> pvehiculos",
				"prutas select(mapColumn(",
				"          rutasAnio = AnioFuente,",
				"          rutasId = RutaHistoricaId",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> srutas",
				"pvehiculos select(mapColumn(",
				"          vehiculosAnio = AnioFuente,",
				"          vehiculosId = VehiculoId",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> svehiculos",
				"source1 derive(each(match(type=='string'), $$ = iif(isNull($$) || trim($$)=='' || in(['NULL','NAN','N/A','NA','S/D','#N/A'], upper(trim($$))), toString(null()), regexReplace(trim($$),'[ ]+',' ')))) ~> derive1",
				"derive1 derive(ViajeId = upper(ViajeId),",
				"          RutaHistoricaId = upper(RutaHistoricaId),",
				"          VehiculoId = upper(VehiculoId),",
				"          FechaServicio = iif(regexMatch(replace(regexReplace(FechaServicio,'[ T].*$',''),'-','/'),'^[0-9]{4}/.*'), toDate(replace(regexReplace(FechaServicio,'[ T].*$',''),'-','/'),'yyyy/M/d'), iif(regexMatch(replace(regexReplace(FechaServicio,'[ T].*$',''),'-','/'),'^[0-9]{5}$'), addDays(toDate('1899-12-30','yyyy-MM-dd'), toInteger(replace(regexReplace(FechaServicio,'[ T].*$',''),'-','/'))), toDate(replace(regexReplace(FechaServicio,'[ T].*$',''),'-','/'),'d/M/yyyy'))),",
				"          HoraProgramada = coalesce(toString(toTimestamp(replace(HoraProgramada,'T',' '),'yyyy-MM-dd HH:mm:ss'),'HH:mm:ss'), toString(toTimestamp(replace(HoraProgramada,'T',' '),'yyyy/MM/d HH:mm:ss'),'HH:mm:ss'), toString(toTimestamp(HoraProgramada,'HH:mm:ss'),'HH:mm:ss'), toString(toTimestamp(HoraProgramada,'H:mm:ss'),'HH:mm:ss'), toString(toTimestamp(HoraProgramada,'HH:mm'),'HH:mm:ss'), toString(toTimestamp(HoraProgramada,'H:mm'),'HH:mm:ss'), toString(null())),",
				"          HoraSalida = coalesce(toString(toTimestamp(replace(HoraSalida,'T',' '),'yyyy-MM-dd HH:mm:ss'),'HH:mm:ss'), toString(toTimestamp(replace(HoraSalida,'T',' '),'yyyy/MM/d HH:mm:ss'),'HH:mm:ss'), toString(toTimestamp(HoraSalida,'HH:mm:ss'),'HH:mm:ss'), toString(toTimestamp(HoraSalida,'H:mm:ss'),'HH:mm:ss'), toString(toTimestamp(HoraSalida,'HH:mm'),'HH:mm:ss'), toString(toTimestamp(HoraSalida,'H:mm'),'HH:mm:ss'), toString(null())),",
				"          HoraLlegada = coalesce(toString(toTimestamp(replace(HoraLlegada,'T',' '),'yyyy-MM-dd HH:mm:ss'),'HH:mm:ss'), toString(toTimestamp(replace(HoraLlegada,'T',' '),'yyyy/MM/d HH:mm:ss'),'HH:mm:ss'), toString(toTimestamp(HoraLlegada,'HH:mm:ss'),'HH:mm:ss'), toString(toTimestamp(HoraLlegada,'H:mm:ss'),'HH:mm:ss'), toString(toTimestamp(HoraLlegada,'HH:mm'),'HH:mm:ss'), toString(toTimestamp(HoraLlegada,'H:mm'),'HH:mm:ss'), toString(null())),",
				"          ValidacionesStr = regexReplace(replace(ValidacionesTarjeta,',','.'),'[^0-9.-]',''),",
				"          KmStr = regexReplace(replace(KmRecorridos,',','.'),'[^0-9.-]',''),",
				"          EstadoViaje = upper(EstadoViaje)) ~> derive2",
				"derive2 derive(AnioFuente = toShort(AnioFuente),",
				"          ValidacionesTarjeta = iif(!isNull(ValidacionesStr) && toDouble(ValidacionesStr) >= 0, toInteger(round(toDouble(ValidacionesStr))), toInteger(null())),",
				"          KmRecorridos = iif(!isNull(KmStr) && toDouble(KmStr) >= 0 && toDouble(KmStr) < 10000000, toDecimal(round(toDouble(KmStr),1),8,1), toDecimal(null(), 8, 1))) ~> derive3",
				"derive3 filter(!isNull(AnioFuente) && !isNull(ViajeId) && length(ViajeId) <= 30 && !isNull(RutaHistoricaId) && length(RutaHistoricaId) <= 30 && !isNull(VehiculoId) && length(VehiculoId) <= 20 && !isNull(FechaServicio) && !isNull(HoraProgramada) && !isNull(HoraSalida) && !isNull(HoraLlegada) && !isNull(ValidacionesTarjeta) && !isNull(KmRecorridos) && !isNull(EstadoViaje) && length(EstadoViaje) <= 20) ~> filter1",
				"filter1 window(over(AnioFuente,",
				"          ViajeId),",
				"     asc(FechaServicio, true),",
				"     rn = rowNumber()) ~> window1",
				"window1 filter(rn == 1) ~> filter2",
				"filter2, srutas exists(AnioFuente == rutasAnio && RutaHistoricaId == rutasId,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1, svehiculos exists(AnioFuente == vehiculosAnio && VehiculoId == vehiculosId,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists2",
				"exists2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}